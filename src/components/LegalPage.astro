---
import Layout from '../layouts/Layout.astro';
import { type Lang } from '../i18n/ui';
import type { LegalSection } from '../data/legal';

interface Props {
  lang: Lang;
  title: string;
  updated: string;
  intro: string;
  sections: LegalSection[];
  keywords?: string;
}

const { lang, title, updated, intro, sections, keywords } = Astro.props;
---

<Layout lang={lang} title={`${title} — Bitáco`} description={intro} keywords={keywords}>
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <p class="uppercase tracking-widest text-brand-accent font-bold text-sm mb-3">Legal</p>
    <h1 class="font-display font-bold text-3xl md:text-4xl mb-3">{title}</h1>
    <p class="text-sm text-brand-bg/50 mb-8">{updated}</p>
    <p class="text-brand-bg/75 text-lg mb-12">{intro}</p>

    <div class="flex flex-col gap-10">
      {sections.map((s) => (
        <section>
          <h2 class="font-display font-semibold text-xl mb-2">{s.titulo}</h2>
          {s.texto.split('\n\n').map((parrafo) => (
            <p class="text-brand-bg/75 leading-relaxed mb-3 whitespace-pre-line">{parrafo}</p>
          ))}
          {s.linkUrl && (
            <a href={s.linkUrl} class="inline-block text-brand-accent font-semibold underline underline-offset-4">
              {s.linkLabel}
            </a>
          )}
        </section>
      ))}
    </div>
  </div>
</Layout>
