---
import '../styles/global.css';
import { type Lang, languages, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);
const allLangs = Object.keys(languages) as Lang[];

// Bandera de país por idioma (no de idioma per se — "inglés" no tiene
// bandera propia, se usa la de EE.UU. como referencia más reconocible).
const langFlags: Record<Lang, string> = {
  es: '🇲🇽',
  en: '🇺🇸',
  fr: '🇫🇷',
  de: '🇩🇪',
  pt: '🇧🇷',
};

// Misma ruta, otro idioma — asume que toda página vive en /es/..., /en/...,
// etc. (routing prefixDefaultLocale: true en astro.config.mjs), así que
// basta con reemplazar el primer segmento de la URL actual.
const currentPath = Astro.url.pathname;
const pathFor = (l: Lang) => currentPath.replace(`/${lang}`, `/${l}`) || `/${l}/`;

// Privacidad y términos solo están traducidos a ES/EN — en FR/DE/PT
// enlazan a la versión en inglés en vez de a una página inexistente.
const legalLang: Lang = lang === 'es' || lang === 'en' ? lang : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Mismas fuentes que la app (src/theme.ts en APPbitaco). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Manrope:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    {allLangs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('es'), Astro.site)} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:locale"
      content={{ es: 'es_MX', en: 'en_US', fr: 'fr_FR', de: 'de_DE', pt: 'pt_BR' }[lang]}
    />

    <!-- Smart App Banner (iOS) — actualizar apple-itunes-app cuando exista el ID real en App Store -->
    <!-- <meta name="apple-itunes-app" content="app-id=TODO" /> -->
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-black/5">
      <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
        <a href={`/${lang}/`} class="flex items-center gap-3 min-w-0">
          <img src="/brand/bitaco-logo-light-bg.svg" alt="Bitáco" class="h-10 md:h-11 w-auto shrink-0" />
          <span class="hidden sm:block font-display font-black text-brand-accent text-sm leading-tight border-l border-black/10 pl-3 max-w-[220px] md:max-w-none">
            {t('nav.tagline')}
          </span>
        </a>
        <div class="flex items-center gap-4">
          <div class="relative">
            <select
              aria-label="Language"
              class="appearance-none text-sm font-semibold uppercase tracking-wide bg-transparent border border-black/15 rounded-full pl-3 pr-7 py-1.5 cursor-pointer"
              onchange="window.location.href = this.value"
            >
              {allLangs.map((l) => (
                <option value={pathFor(l)} selected={l === lang}>
                  {langFlags[l]} {l}
                </option>
              ))}
            </select>
          </div>
          <a
            href="#descargar"
            class="font-display rounded-full bg-brand-accent text-white text-sm font-bold px-4 py-2"
          >
            {t('nav.descargar')}
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-brand-ink text-brand-cream">
      <div class="mx-auto max-w-6xl px-4 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <img src="/brand/bitaco-logo-dark-bg.svg" alt="Bitáco" class="h-7 w-auto" />
        <div class="flex flex-col gap-2">
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <a href={`/${legalLang}/privacidad`}>{t('footer.privacidad')}</a>
            <a href={`/${legalLang}/terminos`}>{t('footer.terminos')}</a>
            <a href={`/${lang}/soporte`}>{t('footer.soporte')}</a>
          </div>
          {t('footer.legalNote') && <p class="text-xs text-brand-cream/40">{t('footer.legalNote')}</p>}
        </div>
        <p class="text-xs text-brand-cream/60 text-center md:text-right">
          © {new Date().getFullYear()} Bitáco. {t('footer.rights')}
          <br />
          {t('footer.credit')}{' '}
          <a href="https://fxckthead.com" target="_blank" rel="noopener" class="underline hover:text-brand-cream">
            fxckthead.com
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
