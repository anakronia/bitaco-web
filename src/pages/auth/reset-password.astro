---
// Página de respaldo para el Android App Link
// auth.bitaco.app/auth/reset-password (ver AuthContext.tsx en la app).
// Mismo patrón que callback.astro — puente hacia bitaco:// cuando el App
// Link no abre la app directo.
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bitáco — restablecer contraseña</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --orange: #F07832;
      --parchment: #F5EFE3;
      --ink: #2A2320;
      --ink-soft: #6B5F55;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100vh; }
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 28px;
      background:
        radial-gradient(760px 420px at 50% -10%, rgba(240,120,50,0.16), transparent 60%),
        var(--parchment);
      font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: var(--ink);
    }
    .card {
      width: 100%;
      max-width: 380px;
      background: #FFFFFF;
      border-radius: 28px;
      padding: 40px 32px 32px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(80, 50, 20, 0.14), 0 2px 6px rgba(80, 50, 20, 0.08);
    }
    .mark { width: 56px; height: 56px; margin: 0 auto 20px; display: block; }
    h1 {
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 700;
      font-size: 26px;
      line-height: 1.2;
      margin: 0 0 14px;
      color: var(--ink);
    }
    p { font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 28px; }
    .btn {
      display: block;
      width: 100%;
      background: var(--orange);
      color: #fff;
      font-family: 'Manrope', sans-serif;
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      padding: 15px 20px;
      border-radius: 14px;
      box-shadow: 0 10px 22px rgba(240, 120, 50, 0.32);
      transition: transform 0.15s ease;
    }
    .btn:active { transform: scale(0.98); }
    .hint { margin: 16px 0 0; font-size: 12.5px; color: var(--ink-soft); opacity: 0.8; }
    .stripe {
      height: 5px;
      border-radius: 6px;
      margin-top: 28px;
      background: linear-gradient(90deg,
        #3355B5 0 12.5%, #C9962A 12.5% 25%, #7B4FB5 25% 37.5%, #C0392B 37.5% 50%,
        #C93B8E 50% 62.5%, #2C8FA6 62.5% 75%, #1F5C3F 75% 87.5%, #E2652B 87.5% 100%);
      opacity: 0.85;
    }
  </style>
</head>
<body>
  <div class="card">
    <img class="mark" alt="Bitáco" src="/brand/bitaco-icon-orange.svg" />
    <h1>Restablece tu contraseña</h1>
    <p>Toca el botón para volver a Bitáco y terminar de cambiar tu contraseña ahí mismo.</p>
    <a class="btn" id="openApp" href="#">Abrir Bitáco</a>
    <p class="hint" id="hintText">Si no se abre sola, usa el botón de arriba.</p>
    <div class="stripe"></div>
  </div>
  <script>
    (function () {
      var suffix = window.location.hash || window.location.search || '';
      var appUrl = 'bitaco://auth/reset-password' + suffix;
      var link = document.getElementById('openApp');
      if (link) link.setAttribute('href', appUrl);
      window.setTimeout(function () {
        window.location.href = appUrl;
      }, 400);
    })();
  </script>
</body>
</html>
