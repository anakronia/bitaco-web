---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" title="Support — Bitáco" description="Questions, a bug, or something to report? Write to us." keywords="Bitáco support, Bitáco app help, contact Bitáco">
  <div class="mx-auto max-w-2xl px-4 py-20 md:py-28 text-center">
    <p class="uppercase tracking-widest text-brand-accent font-bold text-sm mb-3">Support</p>
    <h1 class="font-display font-bold text-3xl md:text-4xl mb-4">How can we help?</h1>
    <p class="text-brand-bg/75 text-lg mb-10">
      If something didn't add up, you found a bug, or you have a question about your account or your
      progress, write to us directly. We answer ourselves, not a bot.
    </p>
    <a
      href="mailto:hola@bitaco.app"
      class="font-display inline-block bg-brand-accent text-white text-lg font-bold px-8 py-4 rounded-full hover:opacity-90 transition"
    >
      hola@bitaco.app
    </a>
  </div>
</Layout>
